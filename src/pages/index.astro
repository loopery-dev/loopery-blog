---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORIES } from '../categories';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const stack = ['Claude Code', 'Obsidian', 'Astro', 'Vercel', 'GitHub'];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} lang="ko" hasTranslation={true} />
		<style>
			.hero {
				text-align: center;
				padding: 4em 1em 3em;
			}
			.hero .eyebrow {
				display: inline-block;
				font-size: 0.85em;
				font-weight: 700;
				letter-spacing: 0.06em;
				color: var(--accent);
				background: rgba(35, 55, 255, 0.08);
				padding: 0.35em 0.9em;
				border-radius: 999px;
				margin-bottom: 1.2em;
			}
			.hero h1 {
				margin: 0 0 0.4em;
				line-height: 1.15;
			}
			.hero p.tagline {
				max-width: 640px;
				margin: 0 auto 1.6em;
				color: rgb(var(--gray));
				font-size: 1.15em;
			}
			.hero .cta {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				background: var(--accent);
				color: white;
				text-decoration: none;
				padding: 0.75em 1.5em;
				border-radius: 999px;
				font-weight: 700;
				transition: background 0.2s ease;
			}
			.hero .cta:hover {
				background: var(--accent-dark);
				color: white;
			}
			.stack {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.5em;
				margin-top: 2em;
			}
			.stack span {
				font-size: 0.8em;
				color: rgb(var(--gray));
				border: 1px solid rgb(var(--gray-light));
				padding: 0.3em 0.8em;
				border-radius: 999px;
			}
			section.topics {
				padding: 1em 1em 3em;
			}
			.topics h2 {
				text-align: center;
				margin-bottom: 1.2em;
			}
			.topic-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.2em;
				max-width: 960px;
				margin: 0 auto;
			}
			.topic-card {
				display: block;
				background: white;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				padding: 1.5em;
				text-decoration: none;
				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease;
			}
			.topic-card:hover {
				transform: translateY(-3px);
				box-shadow: var(--box-shadow);
				color: inherit;
			}
			.topic-card .icon {
				font-size: 1.8em;
				display: block;
				margin-bottom: 0.4em;
			}
			.topic-card h3 {
				margin: 0 0 0.4em;
				font-size: 1.15em;
				color: rgb(var(--black));
			}
			.topic-card p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95em;
				line-height: 1.6;
			}
			section.recent {
				max-width: 720px;
				margin: 0 auto;
				padding: 2em 1em 4em;
			}
			section.recent h2 {
				margin-bottom: 1em;
			}
			.post-row {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1em;
				padding: 1em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
				text-decoration: none;
			}
			.post-row .post-title {
				color: rgb(var(--black));
				font-weight: 700;
			}
			.post-row:hover .post-title {
				color: var(--accent);
			}
			.post-row .post-date {
				flex-shrink: 0;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.recent .more {
				display: block;
				text-align: center;
				margin-top: 1.5em;
			}
			@media (max-width: 720px) {
				.hero {
					padding: 2.5em 1em 2em;
				}
				.topic-grid {
					grid-template-columns: 1fr;
				}
				.post-row {
					flex-direction: column;
					gap: 0.2em;
				}
			}
		</style>
	</head>
	<body>
		<Header lang="ko" altHref="/en" />
		<main>
			<section class="hero">
				<span class="eyebrow">RYAN'S SNOWBALL</span>
				<h1>❄️ 라이언의 스노우볼</h1>
				<p class="tagline">
					Claude Code 같은 AI 에이전트로 자동매매 시스템을 만들고, Obsidian에 쌓은 지식을
					자동으로 블로그까지 발행하는 1인 개발 여정을 기록합니다.
				</p>
				<a class="cta" href="/blog">최신 글 보러가기 →</a>
				<div class="stack">
					{stack.map((s) => <span>{s}</span>)}
				</div>
			</section>

			<section class="topics">
				<h2>이 블로그에서 다루는 것들</h2>
				<div class="topic-grid">
					{
						CATEGORIES.map((c) => (
							<a class="topic-card" href={`/blog/category/${c.slug}/`}>
								<span class="icon">{c.icon}</span>
								<h3>{c.label}</h3>
								<p>{c.desc}</p>
							</a>
						))
					}
				</div>
			</section>

			{
				posts.length > 0 && (
					<section class="recent">
						<h2>최근 글</h2>
						{posts.map((post) => (
							<a class="post-row" href={`/blog/${post.id}/`}>
								<span class="post-title">{post.data.title}</span>
								<span class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</a>
						))}
						<a class="more" href="/blog">전체 글 보기 →</a>
					</section>
				)
			}
		</main>
		<Footer lang="ko" privacyHref="/privacy" />
	</body>
</html>
