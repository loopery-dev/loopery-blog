---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blogEn');
	const koPosts = await getCollection('blog');
	const koIds = new Set(koPosts.map((p) => p.id));
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, hasTranslation: koIds.has(post.id) },
	}));
}
type Props = { post: CollectionEntry<'blogEn'>; hasTranslation: boolean };

const { post, hasTranslation } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} slug={post.id} lang="en" hasTranslation={hasTranslation}>
	<Content />
</BlogPost>
