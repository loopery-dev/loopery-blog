---
// giscus(GitHub Discussions 기반) 댓글 위젯. 설정값은 src/giscus.config.ts 참고.
// data-mapping="pathname"이라 언어별 페이지(/blog/x/ vs /en/blog/x/)는 서로 다른
// Discussion 스레드를 갖는다 — 의도된 동작(한/영 댓글이 안 섞임).
import { GISCUS_CONFIG } from '../giscus.config';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

interface Props {
	lang?: Lang;
}

const { lang = 'ko' } = Astro.props;
const { repo, repoId, category, categoryId } = GISCUS_CONFIG;
---

<section class="comments">
	<h2>{t(lang).comments}</h2>
	<script
		src="https://giscus.app/client.js"
		data-repo={repo}
		data-repo-id={repoId}
		data-category={category}
		data-category-id={categoryId}
		data-mapping="pathname"
		data-strict="0"
		data-reactions-enabled="1"
		data-emit-metadata="0"
		data-input-position="top"
		data-theme="preferred_color_scheme"
		data-lang={lang}
		crossorigin="anonymous"
		async
	/>
</section>

<style>
	.comments {
		margin-top: 3em;
		padding-top: 1.5em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.comments h2 {
		margin-bottom: 1em;
	}
</style>
