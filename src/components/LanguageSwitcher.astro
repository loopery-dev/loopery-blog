---
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

interface Props {
	lang: Lang;
	altHref: string;
}

const { lang, altHref } = Astro.props;
const label = t(lang).switchTo;
---

<a class="lang-switch" href={altHref} rel="alternate">
	🌐 {label}
</a>

<style>
	.lang-switch {
		font-size: 0.85em;
		font-weight: 700;
		color: var(--black);
		text-decoration: none;
		padding: 1em 0.5em;
	}
	.lang-switch:hover {
		color: var(--accent);
	}
</style>
